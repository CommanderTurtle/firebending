<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Core.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="Automation.fs" />
    <Compile Include="Vision.fs" />
    <Compile Include="Formatting.fs" />
    <Compile Include="Delimiters.fs" />
    <Compile Include="Messages.fs" />
    <Compile Include="Inference.fs" />
    <Compile Include="Jev.fs" />
    <Compile Include="Perception.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\contracts\vision-observation.schema.json"
             Link="contracts\vision-observation.schema.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
